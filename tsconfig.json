{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noEmit": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
